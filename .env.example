# ColAI Build & Environment Configuration Template
# Copy this file to .env and fill in your local secrets and signing keys.
# NEVER commit .env or signing keys to version control.

# --- Android Keystore & Signing Configuration ---
# Path to your release keystore (.jks or .keystore file)
COLAI_KEYSTORE_PATH=/path/to/your/upload-keystore.jks
COLAI_KEYSTORE_PASSWORD=your_keystore_password
COLAI_KEY_ALIAS=upload
COLAI_KEY_PASSWORD=your_key_password

# --- Android Build & SDK Configuration ---
# Optional override if not detected from environment
ANDROID_HOME=/opt/android-sdk
ANDROID_NDK_VERSION=28.2.13676358

# --- GeckoView Engine Configuration ---
# Channel: 'stable', 'beta', or 'nightly'
GECKOVIEW_CHANNEL=stable
# Target version (from Mozilla Maven repository https://maven.mozilla.org/maven2/)
GECKOVIEW_VERSION=157.0.20260924084938

# --- Development & Telemetry Flags ---
# Set to 'true' to enable verbose logging in debug builds
COLAI_DEBUG_LOGGING=true
COLAI_STRICT_MODE=false
